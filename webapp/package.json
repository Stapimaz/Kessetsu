{
  "name": "webapp",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ../core --target web --out-dir pkg --release",
    "build:web": "tsc -b && vite build && node scripts/audit-licenses.mjs --output dist/licenses/npm-inventory.json && node scripts/audit-performance.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:unit": "vitest run",
    "build": "npm run build:wasm && npm run build:web",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "eecircuit-engine": "1.7.0",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "rollup": "^4.62.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
